{
  "mcpServers": {
    "blender": {
      "command": "/home/neto/.local/bin/blender-mcp",
      "args": []
    },
    "beads": {
      "command": "/home/neto/.local/bin/uvx",
      "args": ["--from", "beads-mcp", "beads-mcp"],
      "env": {
        "BEADS_WORKING_DIR": "/home/neto/Projects/delve"
      }
    },
    "lightrag": {
      "command": "/home/neto/.local/bin/uvx",
      "args": ["--from", "lightrag-mcp", "lightrag-mcp", "--mcp-transport", "stdio"],
      "env": {
        "LIGHTRAG_BASE_URL": "http://localhost:9621",
        "LIGHTRAG_API_KEY": "lightragsecretkey"
      }
    },
    "json-to-toon": {
      "command": "json-to-toon-mcp-server",
      "args": []
    }
  }
}