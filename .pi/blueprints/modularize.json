{
  "name": "modularize",
  "description": "File size enforcement pipeline: detect oversized files → decouple analysis → implement split → rebuild → verify build.",
  "phases": [
    {
      "name": "detect_file_size_violations",
      "type": "deterministic",
      "handler": "detect_file_size_violations"
    },
    {
      "name": "automodularize",
      "type": "agentic",
      "handler": "automodularize"
    },
    {
      "name": "rebuild_ext",
      "type": "deterministic",
      "handler": "rebuild_ext",
      "on_failure": "fix_build"
    },
    {
      "name": "fix_build",
      "type": "agentic",
      "handler": "fix_build",
      "max_retries": 3,
      "on_success": "rebuild_ext",
      "on_failure": "commit_pr"
    },
    {
      "name": "commit_pr",
      "type": "deterministic",
      "handler": "commit_pr"
    }
  ]
}
