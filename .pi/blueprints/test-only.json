{
  "name": "test-only",
  "description": "Diagnostics and testing only — no implementation, no PR. Runs existing tests and reports results.",
  "phases": [
    {
      "name": "Create branch",
      "type": "deterministic",
      "handler": "branch"
    },
    {
      "name": "Resolve subsystems",
      "type": "deterministic",
      "handler": "resolve_subsystem"
    },
    {
      "name": "Diagnose",
      "type": "agentic",
      "handler": "diagnose"
    },
    {
      "name": "Build",
      "type": "deterministic",
      "handler": "build"
    },
    {
      "name": "Run tests",
      "type": "deterministic",
      "handler": "test"
    }
  ]
}
